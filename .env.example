# Optional analysis backend, inlined at bundle time. Without these the app
# builds with NO endpoint and the ANALYZE button explains that it is optional.

# generate = a /generate JSON endpoint (prompt in, text out)
# openai   = any OpenAI-compatible /v1/chat/completions server
EXPO_PUBLIC_HUGINN_BACKEND=generate
EXPO_PUBLIC_HUGINN_BACKEND_URL=
EXPO_PUBLIC_HUGINN_MODEL=local-model
# Optional display name for the generate backend (e.g. the server's nickname)
EXPO_PUBLIC_HUGINN_BACKEND_LABEL=
